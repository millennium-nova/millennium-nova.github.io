{
    "name": "ACADEMIC PAGES",
    "dockerComposeFile": [
        "../docker-compose.yaml",
        "docker-compose.persist.yaml"
    ],
    "service": "jekyll-site",
    "initializeCommand": "umask 077 && mkdir -p .devcontainer/state/codex .devcontainer/state/vscode-server",
    "remoteEnv": {
        "CODEX_HOME": "/home/vscode/.codex",
        "VSCODE_SERVER_DIR": "/home/vscode/.vscode-server"
    },
    "customizations": {
        "vscode": {
            "extensions": ["openai.chatgpt"]
        }
    },
    "workspaceFolder": "/usr/src/app",
    "remoteUser": "vscode",
    "forwardPorts": [4000]
}
